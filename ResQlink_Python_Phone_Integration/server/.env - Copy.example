# Copy this file to .env and set three distinct, long random tokens.
# Super admin can manage regular admin accounts.
SUPER_ADMIN_TOKEN=replace-with-a-long-random-value
MDRRMO_ADMIN_TOKEN=replace-with-a-long-random-value
CITYHALL_ADMIN_TOKEN=replace-with-a-long-random-value
# Set DATABASE_URL only when using MySQL; URL-encode special characters.
DATABASE_URL=mysql+pymysql://resqlink_user:CHANGE_ME@127.0.0.1:3306/resqlink_db
